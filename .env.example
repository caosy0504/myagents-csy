# Local Ollama (default)
LLM_MODEL_ID=qwen2.5:7b
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT=120

# Shared Agent configuration
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=
AGENT_MAX_HISTORY=20
AGENT_CONTEXT_MAX_TOKENS=4096
AGENT_HISTORY_SUMMARY=true
AGENT_HISTORY_KEEP_RECENT=8
AGENT_TOOL_CALL_MODE=auto
AGENT_MAX_STEPS=5
AGENT_REFLECTION_ITERATIONS=1
AGENT_DEBUG=false

# Chapter 10 protocol connections (all optional)
# Set one MCP transport: Streamable HTTP URL or a trusted stdio command.
MCP_SERVER_URL=
MCP_SERVER_COMMAND=
MCP_BEARER_TOKEN=
A2A_AGENT_URL=
A2A_BEARER_TOKEN=
ANP_SERVICES_FILE=
ANP_DOMAINS=
MY_AGENTS_WORKSPACE=

# Optional search tool
TAVILY_API_KEY=

# Optional Chapter 12 gated GAIA validation access (after accepting its terms)
HF_TOKEN=

# Local RAG (Qdrant + Chinese BGE embedding)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAG_COLLECTION=my_agents_rag_bge_zh_v1
RAG_NAMESPACE=default
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_CANDIDATE_K=12
RAG_MAX_CONTEXT_TOKENS=1800
# Leave empty until a project-specific evaluation set establishes a good cutoff.
RAG_MIN_SCORE=
